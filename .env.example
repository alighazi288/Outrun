# Copy to .env and fill in what your card needs. Never commit .env (it's gitignored).
# `make` loads .env automatically; without make, use `uv run --env-file .env ...`.

# --- Eaton detections and wind (Daniel) ---
# NASA FIRMS map key (free, by email): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# GOES (AWS Open Data) and HRRR wind (herbie) need no key.
FIRMS_MAP_KEY=

# --- Synthetic residents (Rachel) ---
# U.S. Census API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- Intake agent calls the backend (Ali) ---
# From the team IBM Cloud account -> Resource list -> watsonx Orchestrate instance
WXO_INSTANCE_URL=
WXO_API_KEY=
